# Copy this file to ".env" and fill it in. ".env" is git-ignored - never commit it.
# Use a SEND-only shared access policy of your Event Hub (not RootManageSharedAccessKey).
EVENTHUB_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<send-policy-name>;SharedAccessKey=<key>
EVENTHUBS_NAMESPACE=<namespace>.servicebus.windows.net
EVENT_HUB_NAME=hospitalstopic
